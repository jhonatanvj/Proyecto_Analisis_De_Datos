# Copy to .env and fill in. NEVER commit .env
# Identifies the app and a contact to the APIs (polite usage)
HTTP_USER_AGENT="volcano-monitoring-team6/0.1 (Universidad Distrital; contact: your_email@udistrital.edu.co)"
RAW_DATA_DIR=./data/raw
# Project database: service project-db (PostGIS), started with docker compose up -d.
# If a local PostgreSQL already uses 5432 (e.g. installed with pgAdmin), set POSTGRES_PORT=5433.
# Airflow containers ignore HOST/PORT here and use project-db:5432 inside the Docker network.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=volcano
POSTGRES_USER=volcano
POSTGRES_PASSWORD=change_me
# No API keys are required by the chosen sources.
# Workshop 2: Airflow stack (docker compose)
AIRFLOW_UID=50000
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_SECRET_KEY=change_me
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Workshop 4 dashboards: host ports (change them only if 8050/8051 are taken on your machine)
GOVERNANCE_PORT=8050
STORYTELLING_PORT=8051
